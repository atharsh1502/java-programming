class CheckSortedOrNot {
    public static void main(String[] args) {
        
        int arr[] = {8,3,6,6,7};
        int n= arr.length-1;
        
        for(int i=0; i<n; i++){
            if(arr[i]>arr[i+1]){
                System.out.println("Not Sorted");
                return;
            }
        }
        System.out.println("Sorted");
    }
}
