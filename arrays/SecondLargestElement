public class SecondLargestElement {
    public static void main(String[] args) {
        
        int arr[] = {1,3,6,6,5,2};
        int n= arr.length;
        
        int max = Integer.MIN_VALUE;
        int sMax = Integer.MIN_VALUE;
        
        for(int i=0; i<n; i++){
            if(max<arr[i]){
                sMax = max;
                max = arr[i];
            }
            else if(sMax<arr[i] && arr[i]!=max){
                sMax = arr[i];
            }
        }
        
        System.out.println(max);
        System.out.println(sMax);
    }
}
